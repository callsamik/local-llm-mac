#!/usr/bin/env bash
# Claude Code via llm-router: local Qwen / cheap Haiku / frontier Sonnet.
# Auth for hosted lanes: Claude Code CLI login (OAuth) — API key optional.
set -euo pipefail

MODEL="${CLAUDE_ROUTED_MODEL:-claude-sonnet-4-6}"
ROUTER_URL="${LLM_ROUTER_URL:-http://127.0.0.1:11437}"
OLLAMA_URL="${OLLAMA_HOST:-http://127.0.0.1:11434}"
if [[ "${OLLAMA_URL}" != http* ]]; then
  OLLAMA_URL="http://${OLLAMA_URL}"
fi

if ! curl -sf "${ROUTER_URL}/health" >/dev/null 2>&1; then
  printf 'error: llm-router is not up at %s\n' "${ROUTER_URL}" >&2
  printf 'Start it:\n  llm-router\n' >&2
  exit 1
fi
if ! curl -sf "${OLLAMA_URL}/api/tags" >/dev/null 2>&1; then
  printf 'error: Ollama is not running at %s\n' "${OLLAMA_URL}" >&2
  exit 1
fi

unset CLAUDE_CODE_USE_BEDROCK
unset AWS_REGION AWS_DEFAULT_REGION
export ANTHROPIC_BASE_URL="${ROUTER_URL}"
# Sentinel so Claude Code honors BASE_URL; router does not forward this as a real key.
# Hosted lanes use Claude Code CLI OAuth from ~/.claude or Keychain (or a real API key if set).
export ANTHROPIC_AUTH_TOKEN="${ANTHROPIC_AUTH_TOKEN:-ollama}"
if [[ -z "${ANTHROPIC_API_KEY:-}" ]] || [[ "${ANTHROPIC_API_KEY}" == "ollama" ]]; then
  export ANTHROPIC_API_KEY="ollama"
fi
export ANTHROPIC_DEFAULT_HAIKU_MODEL="${ANTHROPIC_DEFAULT_HAIKU_MODEL:-claude-haiku-4-5}"
export ANTHROPIC_DEFAULT_SONNET_MODEL="${ANTHROPIC_DEFAULT_SONNET_MODEL:-${MODEL}}"
export ANTHROPIC_MODEL="${ANTHROPIC_MODEL:-${MODEL}}"

if ! command -v claude >/dev/null 2>&1; then
  printf 'error: Claude Code CLI not found.\n' >&2
  exit 1
fi

# Nudge: hosted lanes need a prior `claude` login if no API key.
if ! curl -sf "${ROUTER_URL}/health" | python3 -c 'import sys,json; d=json.load(sys.stdin); sys.exit(0 if d.get("cloud_auth_ready") else 1)' 2>/dev/null; then
  printf 'note: llm-router has no Anthropic auth yet — cheap/frontier will stay local.\n' >&2
  printf '      Log into Claude Code once (plain `claude`), then restart llm-router.\n' >&2
fi

exec claude --model "${MODEL}" "$@"
